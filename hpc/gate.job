#!/bin/bash
# The pre-HPC gate (docker/gate.sh), run for real on a cluster compute node.
#
# Submit from the repository root, after `make setup-conda`:
#     sbatch hpc/gate.job
#
# It runs `make check`, then two real job scripts from jobs/ with only the
# config swapped for the tiny fixtures (EA and CMA-ES), exports and resumes
# their runs, and checks that a second submit into the same folder is refused.
# Its runs go to output/_gate_4241 and output/_gate_4242 and are replaced by
# the next gate. The log ends in "GATE PASSED at commit <hash>" on success.
#
# It lives outside jobs/ because every job there must train a config.

#SBATCH --account=compsci
#SBATCH --partition=ada
#SBATCH --nodes=1 --ntasks=4
#SBATCH --time=01:00:00
#SBATCH --job-name=oribots_gate
#SBATCH --output=jobs/logs/%x-%j.out
#SBATCH --error=jobs/logs/%x-%j.err

set -euo pipefail

REPO_DIR="${SLURM_SUBMIT_DIR:?submit this job with sbatch from the repository root}"
cd "$REPO_DIR"
if [ ! -f run.py ] || [ ! -d engine ]; then
    echo "$REPO_DIR is not the repository root; submit with: sbatch hpc/gate.job" >&2
    exit 1
fi

module load python/miniconda3-py3.12

if [ ! -x .conda/bin/python ]; then
    echo "Missing conda environment: $REPO_DIR/.conda" >&2
    echo "Create it first with: make setup-conda" >&2
    exit 1
fi

echo "Host: $(hostname)"
echo "Job ID: ${SLURM_JOB_ID:-unset}"

bash docker/gate.sh
